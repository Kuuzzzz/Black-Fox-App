{
  // Black Fox Center on Cloudflare. See SETUP.md for every step.
  "name": "black-fox-center",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  // The app's address. Cloudflare creates the DNS record for it on deploy.
  "routes": [{ "pattern": "blackfox.7mbetlink.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [
    // Step 4 of SETUP.md: paste the database_id that "npx wrangler d1 create black-fox-center" prints.
    { "binding": "DB", "database_name": "black-fox-center", "database_id": "2512c287-dd5f-408b-81b8-2434474963fd" }
  ],
  "vars": {
    "OWNER_EMAIL": "sokheng@hybrid-ad.biz,vengchhan2302@gmail.com",   // owner: sees the private inbox, calendar, AM Brief and Kuro reminders
    "ADMIN_EMAILS": "",                       // comma-separated: people who can see budgets and edit Training
    "AUTH_MODE": "accounts",                // people create their own account (name, email, password)
    "ALLOWED_DOMAIN": "",                     // empty = any email may sign in
    "ACCESS_TEAM_DOMAIN": "silent-smoke-48df.cloudflareaccess.com",               // e.g. hybrid.cloudflareaccess.com  (step 6)
    "ACCESS_AUD": "d7cf29023afc50f8052df1bfd55a41bc779ee66a0ac3db1c1cb7eddabf4f01e8",                       // the Application Audience (AUD) tag from Cloudflare Access (step 6)
    "CLAUDE_MODEL": "claude-sonnet-5-5"
  },
  "observability": { "enabled": true }
}
